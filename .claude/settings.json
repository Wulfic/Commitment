{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf ../*)",
      "Bash(rm -rf $*)",
      "Bash(sudo rm *)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(chmod -R 777 *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --mirror*)",
      "Bash(git filter-branch*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker compose down -v*)",
      "Bash(docker-compose down -v*)",
      "Bash(terraform destroy*)",
      "Bash(kubectl delete*)",
      "Bash(gh repo delete*)",
      "Bash(aws s3 rm*)",
      "Edit(.env)",
      "Write(.env)",
      "Bash(taskkill /IM java*)",
      "Bash(taskkill //IM java*)",
      "Bash(taskkill /F /IM java*)",
      "Bash(taskkill //F //IM java*)",
      "Bash(pkill java*)",
      "Bash(pkill -f java*)",
      "Bash(killall java*)",
      "PowerShell(Stop-Process -Name java*)",
      "PowerShell(taskkill /IM java*)",
      "PowerShell(taskkill /F /IM java*)",
      "PowerShell(Remove-Item -Recurse -Force /*)",
      "PowerShell(Remove-Item -Recurse -Force ~*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git commit --no-verify*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(truncate *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git tag -d*)",
      "Bash(git push --delete*)",
      "Bash(git push origin :refs/tags/*)",
      "Bash(git rm --cached*)",
      "Bash(./gradlew clean*)",
      "Bash(git gc --prune*)",
      "Bash(docker system prune*)",
      "Bash(docker rm*)",
      "Bash(docker rmi*)",
      "Bash(terraform apply*)",
      "Bash(npm publish*)",
      "Bash(dropdb*)",
      "Bash(redis-cli flushall*)",
      "Bash(gh release delete*)",
      "Bash(gh pr close*)",
      "Bash(gh issue close*)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git rebase*)",
      "PowerShell(git commit --amend*)"
    ]
  }
}
