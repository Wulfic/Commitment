#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf
# CI shell scripts run on Linux runners; a CRLF checkout would break them
*.sh            text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# The guard pack's golden files are compared byte for byte with what the mod writes (LF)
common/src/test/resources/guard-pack/** text eol=lf
